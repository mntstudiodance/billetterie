rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Plan de salle : lecture publique (le client doit voir le plan),
    // écriture réservée à l'admin connecté.
    match /venueConfig/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- Réservations (une par numéro de transaction Assoconnect)
    match /bookings/{bookingId} {
      // Lecture d'un document précis autorisée à tous : le client doit
      // pouvoir vérifier son numéro de transaction. La LISTE complète
      // (qui exposerait tous les numéros) reste réservée à l'admin.
      allow get: if true;
      allow list: if request.auth != null;

      allow create, delete: if request.auth != null;

      // Mise à jour autorisée à l'admin, OU au client au moment précis
      // où il valide sa sélection de places (passage pending -> completed,
      // sans toucher à la catégorie ni au nombre de places attendu).
      allow update: if request.auth != null || (
        resource.data.status == 'pending' &&
        request.resource.data.status == 'completed' &&
        request.resource.data.category == resource.data.category &&
        request.resource.data.seatCount == resource.data.seatCount &&
        request.resource.data.seatIds.size() == resource.data.seatCount
      );
    }

    // --- Sièges
    match /seats/{seatId} {
      allow read: if true;

      // L'admin peut tout écrire (génération initiale, réinitialisation).
      // Sinon, deux transitions publiques précises sont autorisées :
      //  1) la vente : "available" -> "sold" (fait par le client en achetant),
      //  2) le contrôle à l'entrée : checkedIn false -> true (fait par la
      //     page /controle, sans authentification, pour un accès rapide le
      //     soir du gala). Dans les deux cas, les champs d'identité du siège
      //     (catégorie, rangée, numéro, transaction) doivent rester inchangés.
      allow write: if request.auth != null || (
        resource.data.status == 'available' &&
        request.resource.data.status == 'sold' &&
        request.resource.data.sectionId == resource.data.sectionId &&
        request.resource.data.row == resource.data.row &&
        request.resource.data.number == resource.data.number &&
        request.resource.data.transactionId is string
      ) || (
        resource.data.status == 'sold' &&
        request.resource.data.status == 'sold' &&
        resource.data.get('checkedIn', false) != true &&
        request.resource.data.checkedIn == true &&
        request.resource.data.sectionId == resource.data.sectionId &&
        request.resource.data.transactionId == resource.data.transactionId
      );
    }
  }
}
